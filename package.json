{
	"name": "second-brain-os",
	"version": "1.0.0",
	"description": "Obsidian plugin that combines a day planner, calendar and periodic notes, and the Pillars, Pipelines & Vaults (PPV) system",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun scripts/build.ts --watch",
		"build": "bun scripts/build.ts",
		"check:bundle": "bun scripts/check-bundle.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun test",
		"test:unit": "bun test tests/unit",
		"test:component": "bun test tests/component",
		"test:integration": "bun test tests/integration",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"version:bump": "bun scripts/version.ts"
	},
	"keywords": [
		"obsidian-plugin"
	],
	"license": "MIT",
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@happy-dom/global-registrator": "^21.0.4",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-boundaries": "^7.4.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"fast-check": "^4.10.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.1",
		"prettier": "^3.9.10",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
